      "@components/ui/calendar": ["./src/app/components/ui/calendar/src/index.ts"],
      "@components/ui/card": ["./src/app/components/ui/card/src/index.ts"],
      "@components/ui/carousel": ["./src/app/components/ui/carousel/src/index.ts"],
      "@components/ui/checkbox": ["./src/app/components/ui/checkbox/src/index.ts"],
