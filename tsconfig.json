      "@services/*": ["./src/app/core/services/*"],
      "@constanst/*": ["./src/app/core/constants/*"],
      "@models/*": ["./src/app/core/models/*"],

      "@components/ui/accordion": ["./src/app/components/ui/accordion/src/index.ts"],
