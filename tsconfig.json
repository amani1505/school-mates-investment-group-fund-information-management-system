      "@components/ui/table": ["./src/app/components/ui/table/src/index.ts"],
      "@components/ui/tabs": ["./src/app/components/ui/tabs/src/index.ts"],
      "@components/ui/textarea": ["./src/app/components/ui/textarea/src/index.ts"],
